#!/usr/bin/env bash
# Refresh an indexnudge database, then pass the query to the real sqlite3.
set -euo pipefail

script="${BASH_SOURCE[0]}"
while [[ -L "$script" ]]; do
    script_dir="$(cd -P "$(dirname "$script")" && pwd)"
    script="$(readlink "$script")"
    [[ "$script" == /* ]] || script="$script_dir/$script"
done
script_dir="$(cd -P "$(dirname "$script")" && pwd)"

# Exclude every PATH alias of this wrapper, not directories containing an indexer.
IFS=: read -ra path_parts <<< "$PATH"
real_path=()
for directory in "${path_parts[@]}"; do
    [[ "${directory:-.}/sqlite3" -ef "$script" ]] || real_path+=("$directory")
done
PATH="$(IFS=:; printf '%s' "${real_path[*]}")"
export PATH
if ! real_sqlite="$(command -v sqlite3)"; then
    printf 'indexnudge: sqlite3 is not installed on PATH\n' >&2
    exit 127
fi

probe=("$real_sqlite" -batch -init /dev/null -cmd '.timeout 5000')
skip=0
parse_options=yes
for arg; do
    if (( skip > 0 )); then
        skip=$((skip - 1))
        continue
    fi
    if [[ "$parse_options" == yes ]]; then
        if [[ "$arg" == -- ]]; then
            parse_options=no
            continue
        fi
        option="$arg"
        [[ "$option" != --* ]] || option="${option#-}"
        case "$option" in
            -cmd|-cmdline-edit|-escape|-init|-maxsize|-mmap|-newline|-nonce|-nullvalue|-screenwidth|-separator|-vfs)
                skip=1; continue ;;
            -lookaside|-pagecache) skip=2; continue ;;
            -A|-help|-version) break ;;
            -*) continue ;;
        esac
    fi
    # Only the database argument is eligible, never SQL or option values.
    [[ "$arg" == file:* ]] && break
    [[ "$arg" == *.indexnudge*.db ]] || break
    if [[ ! -f "$arg" ]]; then
        printf 'indexnudge: index %s does not exist; run the indexer first\n' "$arg" >&2
        exit 1
    fi
    db_dir="$(cd -P "$(dirname "$arg")" && pwd)"
    db="$db_dir/$(basename "$arg")"
    while [[ -L "$db" ]]; do
        target="$(readlink "$db")"
        [[ "$target" == /* ]] || target="$db_dir/$target"
        db_dir="$(cd -P "$(dirname "$target")" && pwd)"
        db="$db_dir/$(basename "$target")"
    done
    # Permit SQLite crash recovery, but never create a database during a probe.
    db_uri="${db//\%/%25}"
    db_uri="${db_uri//\?/%3F}"
    db_uri="file:${db_uri//\#/%23}?mode=rw"
    if ! layout="$("${probe[@]}" "$db_uri" \
        "SELECT CASE
           WHEN EXISTS(SELECT 1 FROM sqlite_schema WHERE name='_indexnudge_state') THEN 'managed'
           WHEN EXISTS(SELECT 1 FROM sqlite_schema WHERE name='files') THEN 'legacy'
           ELSE 'uninitialized' END;")"; then
        printf 'indexnudge: cannot inspect %s\n' "$db" >&2
        exit 1
    fi
    if [[ "$layout" != managed && "$layout" != legacy ]]; then
        printf 'indexnudge: index %s is not initialized; run the indexer first\n' "$db" >&2
        exit 1
    fi
    case "$arg" in
        *.indexnudge-rust.db) language=rust ;;
        *.indexnudge-go.db) language=go ;;
        *)
            if [[ "$layout" == managed ]]; then
                language_sql="SELECT language FROM _indexnudge_state WHERE id=1;"
            else
                language_sql="SELECT DISTINCT language FROM files;"
            fi
            language="$("${probe[@]}" "$db_uri" "$language_sql")"
            ;;
    esac
    case "$language" in
        rust|go) ;;
        *)
            printf 'indexnudge: cannot determine the indexer for %s\n' "$db" >&2
            exit 1
            ;;
    esac

    indexer="$script_dir/../bin-$language/indexnudge"
    # Also support a wrapper copied beside its indexer.
    [[ -x "$indexer" ]] || indexer="$script_dir/indexnudge"
    if [[ ! -x "$indexer" ]]; then
        printf 'indexnudge: missing %s indexer; run make %s\n' "$language" "$language" >&2
        exit 127
    fi
    if [[ "$language" == go ]]; then
        "$indexer" -freshen -dir "$db_dir" -output "$db"
    else
        "$indexer" --freshen "$db_dir" --output "$db"
    fi
    break
done

exec "$real_sqlite" -cmd '.timeout 5000' "$@"
